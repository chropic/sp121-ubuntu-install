#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
set -euo pipefail
repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
for argument in "$@"; do
    if [ "$argument" = --apply ]; then
        [ "$(id -u)" -eq 0 ] || { printf 'Run --apply with sudo.\n' >&2; exit 1; }
        exec unshare --mount --net --propagation private python3 "$repo_root/kernel/live-installer.py" "$@"
    fi
done
exec python3 "$repo_root/kernel/live-installer.py" "$@"
