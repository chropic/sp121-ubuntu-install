+++ b/Documentation/devicetree/bindings/media/i2c/ovti,ov13858.yaml
@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/ovti,ov13858.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OmniVision OV13858 image sensor
+
+maintainers:
+  - Sakari Ailus <sakari.ailus@linux.intel.com>
+
+description: |
+  The sensor is controlled over I2C and outputs image data over MIPI CSI2.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: ovti,ov13858
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+    description: External sensor clock, running at 19.2 MHz.
+
+  assigned-clocks:
+    maxItems: 1
+
+  assigned-clock-rates:
+    items:
+      - const: 19200000
+
+  reset-gpios:
+    maxItems: 1
+    description: Active-low sensor reset.
+
+  afvdd-supply:
+    description: Autofocus power supply.
+
+  dovdd-supply:
+    description: Digital I/O power supply.
+
+  avdd-supply:
+    description: Analog power supply.
+
+  dvdd-supply:
+    description: Digital core power supply.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    unevaluatedProperties: false
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+          link-frequencies:
+            minItems: 1
+            maxItems: 2
+            items:
+              enum: [540000000, 270000000]
+        required:
+          - data-lanes
+          - link-frequencies
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - port
+  - afvdd-supply
+  - dovdd-supply
+  - avdd-supply
+  - dvdd-supply
+
+unevaluatedProperties: false
