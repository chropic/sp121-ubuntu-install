#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
set -eu

usage() {
    printf '%s\n' 'Usage: build-packages --source DIR [--jobs NUMBER] [--kernel v7.2-rc7|v7.3] [--profile platform|camera] [--output DIR] [--cross-compile PREFIX] [--build-only]'
}

source_dir=
jobs=$(nproc)
kernel=v7.2-rc7
profile=platform
output=
cross_compile=
build_only=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --source) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; source_dir=$2; shift 2 ;;
        --jobs) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; jobs=$2; shift 2 ;;
        --kernel) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; kernel=$2; shift 2 ;;
        --profile) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; profile=$2; shift 2 ;;
        --output) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; output=$2; shift 2 ;;
        --cross-compile) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; cross_compile=$2; shift 2 ;;
        --build-only) build_only=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

[ -n "$source_dir" ] || { printf 'Missing --source\n' >&2; exit 2; }
source_dir=$(readlink -f "$source_dir")
case "$jobs" in
    ''|*[!0-9]*) printf 'Invalid job count: %s\n' "$jobs" >&2; exit 2 ;;
esac
[ "$jobs" -gt 0 ] || { printf 'Job count must be positive\n' >&2; exit 2; }
case "$kernel" in
    v7.3)
        repo_root=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)
        set -- --source "$source_dir" --profile "$profile" --jobs "$jobs" --cross-compile "$cross_compile"
        [ -z "$output" ] || set -- "$@" --output "$output"
        [ "$build_only" -ne 1 ] || set -- "$@" --build-only
        exec python3 "$repo_root/kernel/build-candidate.py" "$@"
        ;;
    v7.2-rc7) ;;
    *) printf 'Unsupported kernel: %s\n' "$kernel" >&2; exit 2 ;;
esac
[ "$profile" = platform ] && [ -z "$output$cross_compile" ] && [ "$build_only" -eq 0 ] || {
    printf 'Profile, output, cross-compile and build-only selection require --kernel v7.3\n' >&2
    exit 2
}
if [ "$(git -C "$source_dir" rev-parse HEAD)" = c03c1a14507dfaf8b856c2608f9ac216021fc222 ]; then
    printf 'Select --kernel v7.3 and the matching profile/config explicitly; see kernel/ports/v7.3/README.md.\n' >&2
    exit 1
fi
[ -f "$source_dir/.config" ] || { printf 'Missing prepared .config; run kernel/prepare-tree first\n' >&2; exit 1; }
[ -f "$source_dir/drivers/rtc/rtc-surface.c" ] || { printf 'Release snapshot is not applied\n' >&2; exit 1; }
[ -f "$source_dir/arch/arm64/boot/dts/qcom/x1p42100-microsoft-sp12in.dts" ] || {
    printf 'SP12 DTS is missing\n' >&2
    exit 1
}

for command in make dpkg-buildpackage pahole; do
    command -v "$command" >/dev/null 2>&1 || { printf 'Missing build command: %s\n' "$command" >&2; exit 1; }
done

printf 'Building kernel with %s parallel jobs...\n' "$jobs"
make -C "$source_dir" -j"$jobs" LOCALVERSION=-sp12-extra-camera

printf 'Packaging serially to avoid the observed DTB installation race...\n'
make -C "$source_dir" -j1 bindeb-pkg LOCALVERSION=-sp12-extra-camera

printf 'Build complete. Packages were created beside the kernel source directory.\n'
printf 'Do not install by wildcard; inspect exact package versions and contents first.\n'
